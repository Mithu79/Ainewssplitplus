# ─────────────────────────────────────────────────────────────
# NewsSplit configuration — every value is optional.
# Copy to `.env.local` and adjust to taste.
# ─────────────────────────────────────────────────────────────

# How often the server re-crawls every RSS feed (minutes).
REFRESH_INTERVAL_MINUTES=10

# Per-feed HTTP timeout (seconds) and retry count.
FETCH_TIMEOUT_SECONDS=10
FETCH_RETRIES=1

# How many feeds are downloaded in parallel.
FETCH_CONCURRENCY=6

# Max items kept per feed / per whole store.
MAX_ITEMS_PER_SOURCE=40
MAX_CACHE_ITEMS=1500

# Where the aggregated store is persisted between restarts.
CACHE_FILE=.cache/newssplit.json

# Offline behaviour:
#   auto   -> try live feeds, fall back to the bundled snapshot if all fail (default)
#   always -> never hit the network, serve the bundled snapshot (great for demos/CI)
#   never  -> never fall back; show an empty/error state instead
NEWS_SPLIT_OFFLINE=auto

# Shared secret required by POST /api/refresh (query ?token= or Bearer header).
# Empty = the endpoint is unauthenticated: fine for local dev, but always set a
# strong token on any publicly reachable deployment.
REFRESH_TOKEN=

# ── Local news ──────────────────────────────────────────────
# Region used for the "Local" category when the visitor has not picked one.
LOCAL_DEFAULT_REGION=United States

# Google News locale for the Local category (hl / gl / ceid).
GOOGLE_NEWS_HL=en-US
GOOGLE_NEWS_GL=US
GOOGLE_NEWS_CEID=US:en

# Extra local RSS feeds (comma separated) merged into the Local category.
LOCAL_FEEDS=

# ── Accounts (Auth.js / NextAuth v5) ────────────────────────
# Signs session cookies. REQUIRED in production — generate with `openssl rand -base64 32`.
# When empty a development-only key is used and a warning is logged.
AUTH_SECRET=

# Google OAuth. Leave both empty to offer only email/password sign-in.
# Authorised redirect URI: https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Override the callback base URL when running behind a proxy (usually unnecessary).
# AUTH_URL=https://news.example.com

# Where accounts live (JSON file, bcrypt password hashes). Keep it out of the web root.
USERS_FILE=.cache/newssplit-users.json

# ── Site metadata ───────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=NewsSplit
